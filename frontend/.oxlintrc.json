{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "off",
    "perf": "off",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "plugins": ["typescript", "unicorn", "oxc", "react", "react-perf"],
  "rules": {
    "react/react-in-jsx-scope": "off"
  },
  "ignorePatterns": ["node_modules/", "dist/", "bindings/"]
}
